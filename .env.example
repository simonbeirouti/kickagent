APP_URL=http://localhost:3000
DATABASE_URL=postgresql://user:password@host/database?sslmode=require
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=
TOKEN_ENCRYPTION_KEY=replace-with-at-least-32-random-characters
EVE_INTERNAL_AUTH_SECRET=replace-with-at-least-32-random-characters
ANTHROPIC_API_KEY=
# Optional: restrict sign-in to a specific Kick numeric user ID.
KICK_ALLOWED_USER_ID=
# Optional: override Kick's published webhook verification key.
KICK_PUBLIC_KEY=
# Local development only: scope community-memory tools to one kick_connections UUID.
KICK_CONNECTION_ID=
# X (Twitter) API app-only Bearer token. Trends lookup requires Pro tier or higher.
X_BEARER_TOKEN=AAAAAAAAAAAAAAAAAAAAAPFp%2BwEAAAAAdjAROBxNva8KiKk8Yt5PRVPNhyE%3D3MvrHXOg75GVZp6NrMLfIDwDenItje3O0TwhL8IWC6OBnBUMyD
# Optional: WOEID for trends/by/woeid. Defaults to 1 (worldwide).
X_TRENDS_WOEID=
